
# -*- coding: utf-8 -*-
"""
Controle Financeiro — app de desktop (tkinter) sincronizado com o Excel.

Como usar:
    pip install openpyxl matplotlib
    python app_financas.py

A planilha controle_financeiro.xlsx (na mesma pasta) é criada na primeira vez.
"""
import datetime as dt
import os
import subprocess
import sys
import tkinter as tk
from tkinter import messagebox, ttk

from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from matplotlib.figure import Figure

import financas_core as fc

INTERVALO_MS = 1500
VERDE, VERMELHO, CINZA = "#1b7f3b", "#b00020", "#666666"


def esc(s):
    """Evita que o matplotlib trate $ como fórmula."""
    return s.replace("$", r"\$")


class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Controle Financeiro")
        self.geometry("1200x820")
        self.minsize(1050, 720)
        self.caminho = fc.ARQUIVO_PADRAO
        self.sujo = False
        self._em_conflito = False
        self.conquistas_ok = None
        self.mtime = None

        self._iniciar_dados()
        self._montar()
        self.refresh_all(recarregar_config=True)
        self.checar_conquistas()
        self.protocol("WM_DELETE_WINDOW", self._fechar)
        self.after(INTERVALO_MS, self._tick)

    # ------------------------------------------------ dados e sincronização
    def _iniciar_dados(self):
        if os.path.exists(self.caminho):
            try:
                self.estado = fc.carregar(self.caminho)
            except Exception as ex:
                messagebox.showerror(
                    "Não consegui abrir a planilha",
                    f"{self.caminho}\n\n{ex}\n\nFeche-a no Excel (se estiver aberta) e tente de novo.",
                )
                sys.exit(1)
            self.mtime = self._mtime()
        else:
            self.estado = fc.Estado()
            self._gravar()

    def _mtime(self):
        try:
            return os.path.getmtime(self.caminho)
        except OSError:
            return None

    def _gravar(self):
        try:
            fc.salvar(self.estado, self.caminho)
        except PermissionError:
            self.sujo = True
            self.status("Planilha aberta no Excel: salve e feche para o app gravar. "
                        "Suas alterações estão guardadas e serão gravadas sozinhas.", erro=True)
            return False
        except Exception as ex:
            self.sujo = True
            self.status(f"Erro ao gravar a planilha: {ex}", erro=True)
            return False
        self.sujo = False
        self.mtime = self._mtime()
        self.status(f"Sincronizado com a planilha às {dt.datetime.now():%H:%M:%S}")
        return True

    def _tick(self):
        try:
            self._sincronizar()
        except Exception as ex:  # nunca derruba o app por causa da sincronização
            self.status(f"Aviso de sincronização: {ex}", erro=True)
        finally:
            self.after(INTERVALO_MS, self._tick)

    def _sincronizar(self):
        mt = self._mtime()
        if mt is None:  # planilha apagada: recria
            self._gravar()
            return
        externo = mt != self.mtime
        if self.sujo:
            if externo:
                self._conflito(mt)
            else:
                self._gravar()
            return
        if externo:
            try:
                novo = fc.carregar(self.caminho)
            except Exception:
                return  # Excel ainda gravando; tenta de novo no próximo ciclo
            self.estado, self.mtime = novo, mt
            self.refresh_all(recarregar_config=True)
            self.checar_conquistas()
            self.status(f"Planilha alterada no Excel: app atualizado às {dt.datetime.now():%H:%M:%S}")

    def _conflito(self, mt):
        if self._em_conflito:
            return
        self._em_conflito = True
        try:
            manter = messagebox.askyesno(
                "Alterações nos dois lados",
                "A planilha foi alterada no Excel enquanto o app tinha alterações ainda não gravadas.\n\n"
                "Sim = manter o que está no app (sobrescreve a planilha)\n"
                "Não = carregar a planilha (descarta as alterações pendentes do app)",
            )
            self.mtime = mt
            if manter:
                self._gravar()
            else:
                try:
                    self.estado = fc.carregar(self.caminho)
                except Exception:
                    return
                self.sujo = False
                self.refresh_all(recarregar_config=True)
        finally:
            self._em_conflito = False

    def alterado(self):
        """Chamado depois de qualquer mudança feita no app."""
        self._gravar()
        self.refresh_all()
        self.checar_conquistas()

    def abrir_planilha(self):
        self._gravar()
        try:
            if sys.platform.startswith("win"):
                os.startfile(self.caminho)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", self.caminho])
            else:
                subprocess.Popen(["xdg-open", self.caminho])
        except Exception as ex:
            messagebox.showerror("Erro", f"Não consegui abrir a planilha:\n{ex}")

    def _fechar(self):
        if self.sujo and not self._gravar():
            if not messagebox.askyesno(
                "Alterações não gravadas",
                "Há alterações que ainda não foram gravadas porque a planilha está aberta no Excel.\n"
                "Sair mesmo assim e perdê-las?",
            ):
                return
        self.destroy()

    def status(self, texto, erro=False):
        self.lbl_status.config(text=texto, foreground=VERMELHO if erro else CINZA)

    # ----------------------------------------------------------- interface
    def _montar(self):
        ttk.Style(self).theme_use("clam")
        topo = ttk.Frame(self, padding=(10, 8))
        topo.pack(fill="x")
        ttk.Label(topo, text="Mês:").pack(side="left")
        hoje = dt.date.today()
        self.mes_var = tk.StringVar(value=f"{hoje.month:02d}/{hoje.year}")
        self.cb_mes = ttk.Combobox(topo, textvariable=self.mes_var, width=9, state="readonly")
        self.cb_mes.pack(side="left", padx=(4, 12))
        self.cb_mes.bind("<<ComboboxSelected>>", lambda _e: self.refresh_all())
        ttk.Button(topo, text="Abrir planilha no Excel", command=self.abrir_planilha).pack(side="left")
        self.lbl_status = ttk.Label(topo, text="", foreground=CINZA)
        self.lbl_status.pack(side="right")

        self.nb = ttk.Notebook(self)
        self.nb.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        self._aba_painel()
        self._aba_gastos()
        self._aba_guardado()
        self._aba_config()
        self._aba_invest()
        self._aba_conquistas()

    # ---- painel
    def _aba_painel(self):
        f = ttk.Frame(self.nb, padding=8)
        self.nb.add(f, text="Painel")
        grade = ttk.Frame(f)
        grade.pack(fill="x")
        self.cards = {}
        titulos = [
            ("salario", "Salário"), ("guardar", "Guardar no mês"), ("gastos", "Gastos do mês"),
            ("pode", "Ainda posso gastar"), ("falta_mes", "Falta guardar no mês"),
            ("patr", "Total guardado (c/ rendimento)"),
        ]
        for i, (k, t) in enumerate(titulos):
            box = ttk.LabelFrame(grade, text=t, padding=(10, 4))
            box.grid(row=i // 3, column=i % 3, sticky="nsew", padx=4, pady=4)
            grade.columnconfigure(i % 3, weight=1)
            lbl = ttk.Label(box, text="-", font=("Segoe UI", 15, "bold"))
            lbl.pack(anchor="w")
            self.cards[k] = lbl
        self.lbl_alerta = ttk.Label(f, text="", wraplength=1100, font=("Segoe UI", 10, "bold"))
        self.lbl_alerta.pack(fill="x", pady=(4, 0))

        meta = ttk.LabelFrame(f, text="Meta financeira", padding=8)
        meta.pack(fill="x", pady=6)
        self.lbl_meta = ttk.Label(meta, text="", wraplength=1100, justify="left")
        self.lbl_meta.pack(fill="x")
        self.barra = ttk.Progressbar(meta, maximum=100)
        self.barra.pack(fill="x", pady=(6, 0))

        self.fig = Figure(figsize=(10, 5), dpi=100)
        self.canvas = FigureCanvasTkAgg(self.fig, master=f)
        self.canvas.get_tk_widget().pack(fill="both", expand=True)

    def mes_sel(self):
        try:
            m, a = self.mes_var.get().split("/")
            return int(a), int(m)
        except ValueError:
            h = dt.date.today()
            return h.year, h.month

    def _opcoes_meses(self):
        h = dt.date.today()
        datas = [g["data"] for g in self.estado.gastos] + [a["data"] for a in self.estado.aportes]
        ini = min(datas + [h])
        meses = fc._meses_entre(ini.replace(day=1), h)
        return [f"{m:02d}/{y}" for y, m in reversed(meses)]

    def refresh_painel(self):
        e = self.estado
        ano, mes = self.mes_sel()
        r = fc.resumo(e, ano, mes)
        self.cards["salario"].config(text=fc.brl(r["salario"]))
        self.cards["guardar"].config(text=fc.brl(r["guardar_mes"]))
        self.cards["gastos"].config(text=fc.brl(r["gastos_mes"]))
        self.cards["pode"].config(text=fc.brl(r["pode_gastar"]),
                                  foreground=VERMELHO if r["pode_gastar"] < 0 else VERDE)
        self.cards["falta_mes"].config(text=fc.brl(r["falta_guardar_mes"]))
        self.cards["patr"].config(text=fc.brl(r["patrimonio"]))

        hoje = dt.date.today()
        if e.salario <= 0:
            txt, cor = "Comece pela aba Configurações: informe seu salário e sua meta.", CINZA
        elif r["pode_gastar"] < 0:
            txt, cor = (f"ATENÇÃO: você passou {fc.brl(-r['pode_gastar'])} do que sobra depois de "
                        f"guardar {fc.brl(r['guardar_mes'])}. Segure os gastos ou reveja o quanto guardar."), VERMELHO
        else:
            txt, cor = f"Você ainda pode gastar {fc.brl(r['pode_gastar'])} neste mês sem mexer no que quer guardar.", VERDE
            if (ano, mes) == (hoje.year, hoje.month):
                restam = (fc._fim_mes(ano, mes) - hoje).days + 1
                txt += f" Isso dá cerca de {fc.brl(r['pode_gastar'] / restam)} por dia até o fim do mês."
        self.lbl_alerta.config(text=txt, foreground=cor)

        linhas = [f"Meta: {e.meta_nome} — {fc.brl(r['patrimonio'])} de {fc.brl(r['meta_valor'])} "
                  f"({r['pct_meta']:.0%}). Faltam {fc.brl(r['falta_meta'])}."]
        if r["falta_meta"] <= 0:
            linhas.append("Meta atingida! Que tal definir a próxima?")
        else:
            linhas.append(f"Para bater a meta em {e.prazo_meta_meses} meses, guarde "
                          f"{fc.brl(r['guardar_para_prazo'])} por mês (rendendo {e.rendimento_anual:.1%} a.a.).")
            if r["meses_para_meta"] is None:
                linhas.append("No ritmo atual a meta não é atingida: aumente o valor guardado por mês.")
            else:
                linhas.append(f"No ritmo atual ({fc.brl(r['guardar_mes'])}/mês) você chega lá em "
                              f"cerca de {r['meses_para_meta']} meses.")
        linhas.append(f"Rendimento acumulado até hoje: {fc.brl(r['rendimento'])}.")
        self.lbl_meta.config(text="\n".join(linhas))
        self.barra["value"] = r["pct_meta"] * 100
        self._grafico(r)

    def _grafico(self, r):
        fig = self.fig
        fig.clear()
        gs = fig.add_gridspec(2, 2, height_ratios=[1.15, 1], hspace=0.6, wspace=0.3)
        ax1, ax2, ax3 = fig.add_subplot(gs[0, 0]), fig.add_subplot(gs[0, 1]), fig.add_subplot(gs[1, :])

        cats = {k: v for k, v in r["por_categoria"].items() if v > 0}
        if cats:
            ax1.pie(list(cats.values()), labels=[esc(k) for k in cats], startangle=90,
                    autopct=lambda p: f"{p:.0f}%" if p >= 6 else "", textprops={"fontsize": 8})
        else:
            ax1.text(0.5, 0.5, "Sem gastos neste mês", ha="center", va="center", color=CINZA)
            ax1.axis("off")
        ax1.set_title("Para onde foi o dinheiro", fontsize=10)

        nomes = ["Salário", "Guardar", "Gastos", "Ainda pode gastar"]
        vals = [r["salario"], r["guardar_mes"], r["gastos_mes"], r["pode_gastar"]]
        cores = ["#4c78a8", "#2e8b57", "#e08a1e", VERDE if vals[3] >= 0 else VERMELHO]
        ax2.barh(nomes, vals, color=cores)
        ax2.invert_yaxis()
        top = max(vals + [1])
        ax2.set_xlim(min(0, min(vals)) * 1.3, top * 1.45)
        for i, v in enumerate(vals):
            ax2.text(v + top * 0.02 if v >= 0 else top * 0.02, i, esc(fc.brl(v)),
                     va="center", fontsize=8)
        ax2.tick_params(labelsize=8)
        ax2.set_title("Salário x guardar x gastos", fontsize=10)

        ev = r["evolucao"]
        x = list(range(len(ev)))
        ax3.plot(x, [p[1] for p in ev], marker="o", label="Guardado", color="#2e8b57")
        ax3.plot(x, [p[2] for p in ev], marker="o", label="Com rendimento", color="#4c78a8")
        if r["meta_valor"] > 0:
            ax3.axhline(r["meta_valor"], ls="--", color="gray",
                        label=esc(f"Meta ({fc.brl(r['meta_valor'])})"))
        ax3.set_xticks(x)
        ax3.set_xticklabels([p[0] for p in ev], fontsize=8)
        ax3.tick_params(axis="y", labelsize=8)
        ax3.legend(fontsize=8, loc="upper left")
        ax3.set_title("Evolução do que você guardou", fontsize=10)
        ax3.grid(alpha=0.25)
        fig.subplots_adjust(left=0.07, right=0.97, top=0.93, bottom=0.09)
        self.canvas.draw_idle()

    # ---- gastos
    def _aba_gastos(self):
        f = ttk.Frame(self.nb, padding=8)
        self.nb.add(f, text="Gastos")
        form = ttk.LabelFrame(f, text="Lançar gasto (clique numa linha para editar)", padding=8)
        form.pack(fill="x")
        self.g_data = tk.StringVar(value=dt.date.today().strftime("%d/%m/%Y"))
        self.g_desc, self.g_cat, self.g_val = tk.StringVar(), tk.StringVar(value="Outros"), tk.StringVar()
        for col, (rot, var, larg) in enumerate([("Data", self.g_data, 12), ("Descrição", self.g_desc, 30),
                                                 ("Categoria", self.g_cat, 18), ("Valor (R$)", self.g_val, 12)]):
            ttk.Label(form, text=rot).grid(row=0, column=col, sticky="w", padx=4)
            if rot == "Categoria":
                self.cb_cat = ttk.Combobox(form, textvariable=var, width=larg, values=fc.CATEGORIAS)
                self.cb_cat.grid(row=1, column=col, padx=4)
            else:
                ttk.Entry(form, textvariable=var, width=larg).grid(row=1, column=col, padx=4)
        ttk.Button(form, text="Adicionar", command=self.add_gasto).grid(row=1, column=4, padx=(12, 4))
        ttk.Button(form, text="Atualizar selecionado", command=self.upd_gasto).grid(row=1, column=5, padx=4)
        ttk.Button(form, text="Excluir selecionado", command=self.del_gasto).grid(row=1, column=6, padx=4)
        self.so_mes_g = tk.BooleanVar(value=True)
        ttk.Checkbutton(f, text="Mostrar só o mês selecionado", variable=self.so_mes_g,
                        command=self.refresh_gastos).pack(anchor="w", pady=(6, 0))
        self.tv_g = self._tabela(f, [("data", "Data", 100), ("desc", "Descrição", 340),
                                     ("cat", "Categoria", 160), ("valor", "Valor", 120)])
        self.tv_g.bind("<<TreeviewSelect>>", self._sel_gasto)
        self.lbl_tot_g = ttk.Label(f, text="", font=("Segoe UI", 10, "bold"))
        self.lbl_tot_g.pack(anchor="e", pady=4)

    def _tabela(self, pai, colunas, altura=None):
        wrap = ttk.Frame(pai)
        wrap.pack(fill="both", expand=True, pady=6)
        tv = ttk.Treeview(wrap, columns=[c[0] for c in colunas], show="headings", height=altura or 12)
        for cid, tit, larg in colunas:
            tv.heading(cid, text=tit)
            tv.column(cid, width=larg, anchor="e" if cid in ("valor", "bruto", "ir", "liquido") else "w")
        sb = ttk.Scrollbar(wrap, command=tv.yview)
        tv.configure(yscrollcommand=sb.set)
        tv.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        return tv

    def _ler_gasto(self):
        d, v = fc.data(self.g_data.get()), fc.num(self.g_val.get(), None)
        if d is None or v is None or v <= 0:
            messagebox.showwarning("Dados inválidos", "Informe uma data (dd/mm/aaaa) e um valor maior que zero.")
            return None
        return dict(data=d, descricao=self.g_desc.get().strip(),
                    categoria=self.g_cat.get().strip() or "Outros", valor=v)

    def add_gasto(self):
        g = self._ler_gasto()
        if g:
            self.estado.gastos.append(g)
            self.g_desc.set("")
            self.g_val.set("")
            self.alterado()

    def upd_gasto(self):
        sel = self.tv_g.selection()
        if not sel:
            messagebox.showinfo("Atualizar", "Selecione uma linha da tabela primeiro.")
            return
        g = self._ler_gasto()
        if g:
            self.estado.gastos[int(sel[0])] = g
            self.alterado()

    def del_gasto(self):
        sel = self.tv_g.selection()
        if sel and messagebox.askyesno("Excluir", "Excluir o gasto selecionado?"):
            self.estado.gastos.pop(int(sel[0]))
            self.alterado()

    def _sel_gasto(self, _e):
        sel = self.tv_g.selection()
        if sel:
            g = self.estado.gastos[int(sel[0])]
            self.g_data.set(g["data"].strftime("%d/%m/%Y"))
            self.g_desc.set(g["descricao"])
            self.g_cat.set(g["categoria"])
            self.g_val.set(f"{g['valor']:.2f}".replace(".", ","))

    def refresh_gastos(self):
        ano, mes = self.mes_sel()
        tv = self.tv_g
        tv.delete(*tv.get_children())
        total = 0.0
        itens = sorted(enumerate(self.estado.gastos), key=lambda t: t[1]["data"], reverse=True)
        for i, g in itens:
            if self.so_mes_g.get() and (g["data"].year, g["data"].month) != (ano, mes):
                continue
            total += g["valor"]
            tv.insert("", "end", iid=str(i), values=(g["data"].strftime("%d/%m/%Y"), g["descricao"],
                                                     g["categoria"], fc.brl(g["valor"])))
        self.lbl_tot_g.config(text=f"Total listado: {fc.brl(total)}")
        extras = sorted({g["categoria"] for g in self.estado.gastos} - set(fc.CATEGORIAS))
        self.cb_cat.config(values=fc.CATEGORIAS + extras)

    # ---- guardado
    def _aba_guardado(self):
        f = ttk.Frame(self.nb, padding=8)
        self.nb.add(f, text="Guardado")
        form = ttk.LabelFrame(f, text="Registrar dinheiro guardado (clique numa linha para editar)", padding=8)
        form.pack(fill="x")
        self.a_data = tk.StringVar(value=dt.date.today().strftime("%d/%m/%Y"))
        self.a_val, self.a_obs = tk.StringVar(), tk.StringVar()
        for col, (rot, var, larg) in enumerate([("Data", self.a_data, 12), ("Valor (R$)", self.a_val, 14),
                                                 ("Observação", self.a_obs, 34)]):
            ttk.Label(form, text=rot).grid(row=0, column=col, sticky="w", padx=4)
            ttk.Entry(form, textvariable=var, width=larg).grid(row=1, column=col, padx=4)
        ttk.Button(form, text="Adicionar", command=self.add_aporte).grid(row=1, column=3, padx=(12, 4))
        ttk.Button(form, text="Atualizar selecionado", command=self.upd_aporte).grid(row=1, column=4, padx=4)
        ttk.Button(form, text="Excluir selecionado", command=self.del_aporte).grid(row=1, column=5, padx=4)
        self.lbl_tot_a = ttk.Label(f, text="", font=("Segoe UI", 10, "bold"))
        self.lbl_tot_a.pack(anchor="w", pady=(8, 0))
        self.tv_a = self._tabela(f, [("data", "Data", 100), ("valor", "Valor", 140), ("obs", "Observação", 420)])
        self.tv_a.bind("<<TreeviewSelect>>", self._sel_aporte)

    def _ler_aporte(self):
        d, v = fc.data(self.a_data.get()), fc.num(self.a_val.get(), None)
        if d is None or v is None or v <= 0:
            messagebox.showwarning("Dados inválidos", "Informe uma data (dd/mm/aaaa) e um valor maior que zero.")
            return None
        return dict(data=d, valor=v, obs=self.a_obs.get().strip())

    def add_aporte(self):
        a = self._ler_aporte()
        if a:
            self.estado.aportes.append(a)
            self.a_val.set("")
            self.a_obs.set("")
            self.alterado()

    def upd_aporte(self):
        sel = self.tv_a.selection()
        if not sel:
            messagebox.showinfo("Atualizar", "Selecione uma linha da tabela primeiro.")
            return
        a = self._ler_aporte()
        if a:
            self.estado.aportes[int(sel[0])] = a
            self.alterado()

    def del_aporte(self):
        sel = self.tv_a.selection()
        if sel and messagebox.askyesno("Excluir", "Excluir o registro selecionado?"):
            self.estado.aportes.pop(int(sel[0]))
            self.alterado()

    def _sel_aporte(self, _e):
        sel = self.tv_a.selection()
        if sel:
            a = self.estado.aportes[int(sel[0])]
            self.a_data.set(a["data"].strftime("%d/%m/%Y"))
            self.a_val.set(f"{a['valor']:.2f}".replace(".", ","))
            self.a_obs.set(a["obs"])

    def refresh_guardado(self):
        e = self.estado
        tv = self.tv_a
        tv.delete(*tv.get_children())
        for i, a in sorted(enumerate(e.aportes), key=lambda t: t[1]["data"], reverse=True):
            tv.insert("", "end", iid=str(i), values=(a["data"].strftime("%d/%m/%Y"), fc.brl(a["valor"]), a["obs"]))
        r = fc.resumo(e, *self.mes_sel())
        self.lbl_tot_a.config(
            text=f"Guardado: {fc.brl(r['total_guardado'])}   |   Rendimento: {fc.brl(r['rendimento'])}   |   "
                 f"Total com rendimento: {fc.brl(r['patrimonio'])}")

    # ---- configurações
    def _aba_config(self):
        f = ttk.Frame(self.nb, padding=12)
        self.nb.add(f, text="Configurações")
        self.cfg_vars = {}
        for i, (chave, rotulo, tipo, obs) in enumerate(fc.CFG):
            ttk.Label(f, text=rotulo).grid(row=i, column=0, sticky="w", pady=3)
            var = tk.StringVar()
            ttk.Entry(f, textvariable=var, width=22).grid(row=i, column=1, padx=8)
            ttk.Label(f, text=obs, foreground=CINZA).grid(row=i, column=2, sticky="w")
            self.cfg_vars[chave] = var
        ttk.Button(f, text="Salvar configurações", command=self.salvar_cfg).grid(
            row=len(fc.CFG), column=0, columnspan=2, pady=14, sticky="w")
        ttk.Label(f, text="Porcentagens: digite o número (ex.: 20 para 20%). Datas: dd/mm/aaaa.",
                  foreground=CINZA).grid(row=len(fc.CFG) + 1, column=0, columnspan=3, sticky="w")

    def _fmt_cfg(self, v, tipo):
        if tipo == "moeda":
            return f"{v:.2f}".replace(".", ",")
        if tipo == "pct":
            return f"{v * 100:.2f}".replace(".", ",")
        if tipo == "data":
            return v.strftime("%d/%m/%Y")
        return str(v)

    def preencher_cfg(self):
        for chave, _r, tipo, _o in fc.CFG:
            self.cfg_vars[chave].set(self._fmt_cfg(getattr(self.estado, chave), tipo))

    def salvar_cfg(self):
        e = self.estado
        for chave, rotulo, tipo, _o in fc.CFG:
            txt = self.cfg_vars[chave].get().strip()
            if tipo == "moeda":
                v = fc.num(txt, None)
            elif tipo == "pct":
                v = fc.num(txt, None)
                v = None if v is None else v / 100
            elif tipo == "int":
                v = fc.num(txt, None)
                v = None if v is None else int(v)
            elif tipo == "data":
                v = fc.data(txt)
            else:
                v = txt
            if v is None or (tipo in ("moeda", "int") and v < 0):
                messagebox.showwarning("Valor inválido", f"Confira o campo: {rotulo}")
                return
            setattr(e, chave, v)
        self.alterado()
        self.preencher_cfg()

    # ---- investimentos
    def _aba_invest(self):
        f = ttk.Frame(self.nb, padding=8)
        self.nb.add(f, text="Investimentos")
        self.lbl_ind = ttk.Label(f, font=("Segoe UI", 10, "bold"))
        self.lbl_ind.pack(anchor="w")
        self.tv_i = self._tabela(f, [
            ("pos", "#", 30), ("nome", "Investimento", 230), ("bruto", "Bruto a.a.", 80), ("ir", "IR", 60),
            ("liquido", "Líquido a.a.", 90), ("liq", "Liquidez", 170), ("risco", "Risco", 90),
            ("obs", "Observação", 420)], altura=7)
        self.txt_dicas = tk.Text(f, height=9, wrap="word", font=("Segoe UI", 10), relief="flat",
                                 background=self.cget("background"))
        self.txt_dicas.pack(fill="x", pady=4)

        sim = ttk.LabelFrame(f, text="Simulador: e se eu guardar todo mês?", padding=8)
        sim.pack(fill="x")
        self.s_inv = tk.StringVar()
        self.s_aporte, self.s_meses = tk.StringVar(), tk.StringVar(value="12")
        ttk.Label(sim, text="Investimento").grid(row=0, column=0, sticky="w")
        self.cb_sim = ttk.Combobox(sim, textvariable=self.s_inv, width=34, state="readonly")
        self.cb_sim.grid(row=1, column=0, padx=4)
        ttk.Label(sim, text="Por mês (R$)").grid(row=0, column=1, sticky="w")
        ttk.Entry(sim, textvariable=self.s_aporte, width=12).grid(row=1, column=1, padx=4)
        ttk.Label(sim, text="Meses").grid(row=0, column=2, sticky="w")
        ttk.Entry(sim, textvariable=self.s_meses, width=8).grid(row=1, column=2, padx=4)
        ttk.Button(sim, text="Simular", command=self.simular).grid(row=1, column=3, padx=8)
        self.lbl_sim = ttk.Label(sim, text="", wraplength=1000, justify="left")
        self.lbl_sim.grid(row=2, column=0, columnspan=5, sticky="w", pady=(6, 0))

    def simular(self):
        nome = self.s_inv.get()
        inv = next((i for i in self.estado.investimentos if i["nome"] == nome), None)
        ap, meses = fc.num(self.s_aporte.get(), None), fc.num(self.s_meses.get(), None)
        if inv is None or ap is None or meses is None or ap < 0 or meses < 1:
            messagebox.showwarning("Simulador", "Escolha um investimento e informe valor mensal e meses.")
            return
        s = fc.simular(self.estado, inv, ap, meses)
        self.lbl_sim.config(text=(
            f"Guardando {fc.brl(ap)} por {int(meses)} meses em {nome}: você investe {fc.brl(s['investido'])} "
            f"e terminaria com cerca de {fc.brl(s['liquido_final'])} líquidos "
            f"(ganho de {fc.brl(s['ganho_liquido'])}). Estimativa com a taxa atual, sem garantia."))

    def refresh_invest(self):
        e = self.estado
        self.lbl_ind.config(text=f"Referência: Selic {e.selic:.2%} a.a. | CDI {e.cdi:.2%} a.a. | "
                                 f"IPCA 12m {e.ipca:.2%} (ajuste na aba Configurações)")
        tv = self.tv_i
        tv.delete(*tv.get_children())
        for pos, x in enumerate(fc.ranking_investimentos(e), 1):
            tv.insert("", "end", values=(pos, x["nome"], f"{x['bruto']:.2%}", f"{x['ir']:.1%}",
                                         f"{x['liquido']:.2%}", x["liquidez"], x["risco"], x["obs"]))
        t = self.txt_dicas
        t.config(state="normal")
        t.delete("1.0", "end")
        t.insert("end", "\n\n".join(fc.dicas(e)))
        t.config(state="disabled")
        nomes = [i["nome"] for i in e.investimentos]
        self.cb_sim.config(values=nomes)
        if self.s_inv.get() not in nomes and nomes:
            self.s_inv.set(nomes[0])
        if not self.s_aporte.get():
            self.s_aporte.set(f"{e.salario * e.pct_guardar:.2f}".replace(".", ","))

    # ---- conquistas
    def _aba_conquistas(self):
        f = ttk.Frame(self.nb, padding=8)
        self.nb.add(f, text="Conquistas")
        self.lbl_conq = ttk.Label(f, font=("Segoe UI", 12, "bold"))
        self.lbl_conq.pack(anchor="w")
        self.tv_c = self._tabela(f, [("st", "", 40), ("grupo", "Grupo", 90), ("nome", "Conquista", 260),
                                     ("desc", "Como desbloquear", 440), ("prog", "Progresso", 90)], altura=20)
        self.tv_c.tag_configure("ok", foreground=VERDE)
        self.tv_c.tag_configure("bloq", foreground="#888888")

    def refresh_conquistas(self):
        lista = fc.conquistas(self.estado)
        tv = self.tv_c
        tv.delete(*tv.get_children())
        for c in lista:
            tv.insert("", "end", tags=("ok" if c["ok"] else "bloq",),
                      values=("★" if c["ok"] else "☆", c["grupo"], c["nome"], c["desc"], f"{c['prog']:.0%}"))
        self.lbl_conq.config(text=f"{sum(c['ok'] for c in lista)} de {len(lista)} conquistas desbloqueadas")

    def checar_conquistas(self):
        atuais = {c["id"]: c for c in fc.conquistas(self.estado) if c["ok"]}
        if self.conquistas_ok is not None:
            novas = [c["nome"] for k, c in atuais.items() if k not in self.conquistas_ok]
            if novas:
                messagebox.showinfo("Conquista desbloqueada!", "\n".join("★ " + n for n in novas))
        self.conquistas_ok = set(atuais)

    # ---- atualizar tudo
    def refresh_all(self, recarregar_config=False):
        opcoes = self._opcoes_meses()
        self.cb_mes.config(values=opcoes)
        if self.mes_var.get() not in opcoes:
            self.mes_var.set(opcoes[0])
        self.refresh_painel()
        self.refresh_gastos()
        self.refresh_guardado()
        self.refresh_invest()
        self.refresh_conquistas()
        if recarregar_config:
            self.preencher_cfg()


